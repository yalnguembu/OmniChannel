# Origine de l'API OmniChannel (SANS /api final — les chemins du client l'incluent
# déjà). Doit être une URL absolue : contrairement au web, une app mobile n'a pas
# d'origine relative ni de proxy de dev.
EXPO_PUBLIC_API_URL=https://api.omnichannel.nguetioofa.dev

# Optionnel : hôte du hub SignalR si différent de l'origine API.
# EXPO_PUBLIC_SIGNALR_URL=
