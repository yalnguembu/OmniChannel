{
  "name": "fujipay.web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:route": "tsr generate",
    "build": "tsc -b && vite build",
    "build:prod": "npm run generate:route && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "parse": "npx i18next-parser && tsx generate-i18n-types.ts",
    "generate:api": "npx @hey-api/openapi-ts",
    "generate:components": "cd generator && npm run auto-components",
    "release:dev": "standard-version --prerelease dev",
    "release:prod": "standard-version",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/images/icon.png"
  },
  "dependencies": {
