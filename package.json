    "@tanstack/router-cli": "^1.122.0",
    "@tanstack/router-plugin": "^1.120.5",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
