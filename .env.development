# Dev only — overrides .env when running `vite dev`.
# Routes the API + SignalR through the Vite proxy (vite.config.ts) so the
# browser stays same-origin → no CORS, and the login cookie flows with
# withCredentials. Empty VITE_API_URL makes the app use relative URLs.
VITE_API_URL=
VITE_API_PROXY_TARGET=https://api.omnichannel.nguetioofa.dev
