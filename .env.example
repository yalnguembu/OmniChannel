# ── API ──────────────────────────────────────────────────────────────────────
# App API base URL. Generated SDK paths already include `/api`, so set the
# ORIGIN only (no trailing /api).
#   • Dev: leave EMPTY (see .env.development) → relative URLs go through the Vite
#     proxy below (same-origin, no CORS; the login cookie flows with withCredentials).
#   • Prod / direct: set to the absolute API origin (server CORS must allow credentials).
VITE_API_URL=

# Backend the Vite dev proxy forwards /api and /hubs to (dev only; see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:5000

# ── ReaboCanal (fujisat) ─────────────────────────────────────────────────────
# Base URL of the ReaboCanal API used by the réabonnement features in the
# WhatsApp inbox. Absolute and independent from VITE_API_URL — it is a
# different host with its own token. Defaults to production when unset.
#
# ORIGIN ONLY, no /api/v1: the generated SDK paths already carry that prefix.
VITE_REABO_API_URL=https://fujisat.cm:4430
